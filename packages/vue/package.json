{
  "name": "@donega/form-wrapper-vue",
  "version": "0.1.0",
  "description": "Vue 3 adapter for @donega/form-wrapper — reactive bindings for the headless form controller",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@donega/form-wrapper": "file:../.."
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  },
  "sideEffects": false,
  "keywords": [
    "vue",
    "form",
    "headless",
    "form-state"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielDonega/form-wrapper.git",
    "directory": "packages/vue"
  },
  "license": "MIT"
}
