{
  "name": "@donega/form-wrapper",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic form state controller with typed nested paths",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "keywords": [
    "form",
    "headless",
    "form-state",
    "validation",
    "typescript",
    "framework-agnostic"
  ],
  "author": {
    "name": "Gabriel Donegá",
    "url": "https://github.com/GabrielDonega"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielDonega/form-wrapper.git"
  },
  "bugs": {
    "url": "https://github.com/GabrielDonega/form-wrapper/issues"
  },
  "homepage": "https://github.com/GabrielDonega/form-wrapper#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
